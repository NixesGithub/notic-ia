# Clave usada por n8n para cifrar credenciales. Generá una propia con:
#   openssl rand -hex 32
# Si la cambiás después de haber guardado credenciales, dejan de poder desencriptarse.
N8N_ENCRYPTION_KEY=cambiame-por-una-clave-larga-y-aleatoria

# Puerto en el que se expone la UI en tu máquina
N8N_PORT=5678

# Zona horaria por defecto para los nodos de fecha/schedule
GENERIC_TIMEZONE=Europe/Madrid

# Chat de Telegram donde se recibe el resumen diario de noticias de IA.
# Para obtenerlo: escribile a tu bot y abrí
#   https://api.telegram.org/bot<TU_TOKEN>/getUpdates
# El número está en result[0].message.chat.id
TELEGRAM_CHAT_ID=
